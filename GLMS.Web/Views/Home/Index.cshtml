@model GLMS.Web.ViewModels.HomeDashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<section class="dashboard-hero p-4 p-md-5 mb-4 rounded-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="eyebrow">TECHMOVE LOGISTICS</span>
            <h1 class="display-5 fw-bold mt-2">Global Logistics Management System</h1>
            <p class="lead mb-4">Manage client contracts, monitor compliance, and track service requests from one central workspace.</p>
            <a asp-controller="Clients" asp-action="Create" class="btn btn-light btn-lg me-2">Add client</a>
            <a asp-controller="Contracts" asp-action="Create" class="btn btn-outline-light btn-lg me-2">Create contract</a>
            <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-outline-light btn-lg">New service request</a>
        </div>
        <div class="col-lg-4 d-none d-lg-block text-end">
            <div class="hero-symbol">GLMS</div>
            <div class="small opacity-75">Contracts · Operations · Finance</div>
        </div>
    </div>
</section>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Clients</div><div class="metric-value">@Model.TotalClients</div><div class="metric-foot">Registered organisations</div></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">All contracts</div><div class="metric-value">@Model.TotalContracts</div><div class="metric-foot">Across all statuses</div></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Active contracts</div><div class="metric-value text-success">@Model.ActiveContracts</div><div class="metric-foot">Currently operational</div></div></div>
    <div class="col-6 col-xl-3"><div class="metric-card"><div class="metric-label">Expired contracts</div><div class="metric-value text-danger">@Model.ExpiredContracts</div><div class="metric-foot">Review before new work</div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><h2 class="h5 mb-1">Recent service requests</h2><p class="text-muted small mb-0">Latest requests recorded in the system</p></div>
                <a asp-controller="ServiceRequests" asp-action="Index" class="btn btn-sm btn-outline-primary">View all</a>
            </div>
            @if (Model.RecentRequests.Count == 0)
            {
                <div class="empty-state">No service requests yet. Create a request against an active contract to get started.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table align-middle mb-0">
                    <thead><tr><th>Request</th><th>Client</th><th>USD</th><th>ZAR</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var request in Model.RecentRequests)
                    {
                        <tr>
                            <td><strong>#@request.Id</strong><div class="small text-muted text-truncate request-description">@request.Description</div></td>
                            <td>@request.Contract?.Client?.Name</td>
                            <td>$@request.CostInUSD.ToString("N2")</td>
                            <td>R @request.CostInZAR.ToString("N2")</td>
                            <td><span class="status-pill">@request.Status</span></td>
                        </tr>
                    }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="panel-card mb-4">
            <h2 class="h5 mb-3">Quick actions</h2>
            <a class="quick-link" asp-controller="Clients" asp-action="Index"><span class="quick-icon">01</span><span><strong>Client management</strong><small>Add, search, and update client records</small></span><span class="ms-auto">→</span></a>
            <a class="quick-link" asp-controller="Contracts" asp-action="Index"><span class="quick-icon">02</span><span><strong>Contract management</strong><small>Search, filter and download agreements</small></span><span class="ms-auto">→</span></a>
            <a class="quick-link" asp-controller="ServiceRequests" asp-action="Index"><span class="quick-icon">03</span><span><strong>Service requests</strong><small>Review logistics work and costs</small></span><span class="ms-auto">→</span></a>
            <a class="quick-link" asp-controller="ServiceRequests" asp-action="Create"><span class="quick-icon">04</span><span><strong>Currency conversion</strong><small>Calculate USD costs in ZAR</small></span><span class="ms-auto">→</span></a>
        </div>
        <div class="panel-card finance-card">
            <div class="metric-label">Service request value</div>
            <div class="metric-value">R @Model.TotalServiceRequestValueZar.ToString("N2")</div>
            <p class="small text-muted mb-0">Combined ZAR value of @Model.TotalServiceRequests request(s).</p>
        </div>
    </div>
</div>
