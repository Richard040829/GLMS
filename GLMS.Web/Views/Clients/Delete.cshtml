@model GLMS.Web.Models.Client
@{ ViewData["Title"] = "Delete client"; }
<div class="mb-4"><a asp-action="Index" class="text-decoration-none">← Back to clients</a><h1 class="h2 mt-2">Delete client</h1></div>
<div class="panel-card" style="max-width:760px">
    @if (Model.Contracts.Count > 0)
    {
        <div class="alert alert-warning"><strong>This client cannot be deleted yet.</strong><p class="mb-0">There are @Model.Contracts.Count contract(s) linked to this client. Reassign or remove the related contracts before deleting the client.</p></div>
        <a asp-action="Index" class="btn btn-primary">Back to clients</a>
    }
    else
    {
        <div class="alert alert-danger">Are you sure you want to delete this client? This action cannot be undone.</div>
        <dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Contact details</dt><dd class="col-sm-9">@Model.ContactDetails</dd><dt class="col-sm-3">Region</dt><dd class="col-sm-9">@Model.Region</dd></dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="btn btn-danger">Delete client</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
    }
</div>
